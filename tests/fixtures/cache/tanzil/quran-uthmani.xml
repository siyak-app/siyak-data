<quran>
	<sura index="1" name="الفاتحة">
		<aya index="1" text="بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ" />
		<aya index="2" text="ٱلْحَمْدُ لِلَّهِ رَبِّ ٱلْعَـٰلَمِينَ" />
		<aya index="3" text="ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ" />
		<aya index="4" text="مَـٰلِكِ يَوْمِ ٱلدِّينِ" />
		<aya index="5" text="إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ" />
		<aya index="6" text="ٱهْدِنَا ٱلصِّرَٰطَ ٱلْمُسْتَقِيمَ" />
		<aya index="7" text="صِرَٰطَ ٱلَّذِينَ أَنْعَمْتَ عَلَيْهِمْ غَيْرِ ٱلْمَغْضُوبِ عَلَيْهِمْ وَلَا ٱلضَّآلِّينَ" />
	</sura>
	<sura index="97" name="القدر">
		<aya index="1" text="إِنَّآ أَنزَلْنَـٰهُ فِى لَيْلَةِ ٱلْقَدْرِ" bismillah="بِّسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ" />
		<aya index="2" text="وَمَآ أَدْرَىٰكَ مَا لَيْلَةُ ٱلْقَدْرِ" />
		<aya index="3" text="لَيْلَةُ ٱلْقَدْرِ خَيْرٌ مِّنْ أَلْفِ شَهْرٍ" />
		<aya index="4" text="تَنَزَّلُ ٱلْمَلَـٰٓئِكَةُ وَٱلرُّوحُ فِيهَا بِإِذْنِ رَبِّهِم مِّن كُلِّ أَمْرٍ" />
		<aya index="5" text="سَلَـٰمٌ هِىَ حَتَّىٰ مَطْلَعِ ٱلْفَجْرِ" />
	</sura>
	<sura index="112" name="الإخلاص">
		<aya index="1" text="قُلْ هُوَ ٱللَّهُ أَحَدٌ" bismillah="بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ" />
		<aya index="2" text="ٱللَّهُ ٱلصَّمَدُ" />
		<aya index="3" text="لَمْ يَلِدْ وَلَمْ يُولَدْ" />
		<aya index="4" text="وَلَمْ يَكُن لَّهُۥ كُفُوًا أَحَدٌۢ" />
	</sura>
	<sura index="113" name="الفلق">
		<aya index="1" text="قُلْ أَعُوذُ بِرَبِّ ٱلْفَلَقِ" bismillah="بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ" />
		<aya index="2" text="مِن شَرِّ مَا خَلَقَ" />
		<aya index="3" text="وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ" />
		<aya index="4" text="وَمِن شَرِّ ٱلنَّفَّـٰثَـٰتِ فِى ٱلْعُقَدِ" />
		<aya index="5" text="وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ" />
	</sura>
	<sura index="114" name="الناس">
		<aya index="1" text="قُلْ أَعُوذُ بِرَبِّ ٱلنَّاسِ" bismillah="بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ" />
		<aya index="2" text="مَلِكِ ٱلنَّاسِ" />
		<aya index="3" text="إِلَـٰهِ ٱلنَّاسِ" />
		<aya index="4" text="مِن شَرِّ ٱلْوَسْوَاسِ ٱلْخَنَّاسِ" />
		<aya index="5" text="ٱلَّذِى يُوَسْوِسُ فِى صُدُورِ ٱلنَّاسِ" />
		<aya index="6" text="مِنَ ٱلْجِنَّةِ وَٱلنَّاسِ" />
	</sura>
</quran>
